class DevisManager:

    def __init__(self, parent):

        self.parent = parent

        self.conn = sqlite3.connect("fms_manager.db")
        self.cur = self.conn.cursor()
        self.verifier_base()

        self.lignes=[]
        self.devis_selectionne=None
        self.creer_fenetre()
        
    def verifier_base(self):

     self.cur.execute("""
        CREATE TABLE IF NOT EXISTS devis (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            numero TEXT,
            date TEXT,
            client TEXT,
            immatriculation TEXT,
            montant_ht REAL,
            tva REAL,
            montant_ttc REAL
        )
     """)

     self.cur.execute("""
        CREATE TABLE IF NOT EXISTS lignes_devis (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            devis_id INTEGER,
            reference TEXT,
            designation TEXT,
            quantite REAL,
            prix_ht REAL,
            tva REAL,
            total REAL
        )
     """)

     self.conn.commit()

    def generer_numero_devis(self):

     annee = datetime.now().year

     self.cur.execute("""
        SELECT numero
        FROM devis
        WHERE numero LIKE ?
        ORDER BY id DESC
        LIMIT 1
     """, (f"DV-{annee}-%",))

     resultat = self.cur.fetchone()

     if resultat:
        dernier = int(resultat[0].split("-")[-1]) + 1
     else:
        dernier = 1

     return f"DV-{annee}-{dernier:04d}"


